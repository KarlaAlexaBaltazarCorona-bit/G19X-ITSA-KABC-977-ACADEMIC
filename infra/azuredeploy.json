{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "PluriOne LegalTech Infrastructure Packager",
      "version": "1.0.0"
    },
    "description": "Plantilla Click-to-Go para aprovisionamiento automatizado llave en mano de la plataforma PluriOne LegalTech en el tenant de Azure del cliente."
  },
  "parameters": {
    "appNamePrefix": {
      "type": "string",
      "defaultValue": "legaltech",
      "metadata": {
        "description": "Prefijo para los nombres de los recursos aprovisionados."
      }
    },
    "environmentType": {
      "type": "string",
      "defaultValue": "Standard",
      "allowedValues": [
        "Standard",
        "Enterprise_HA"
      ],
      "metadata": {
        "description": "Perfil de infraestructura: 'Standard' (eficiente en costo para operaciones cotidianas) o 'Enterprise_HA' (Alta Disponibilidad multizona, auto-scaling y redundancia empresarial)."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Región geográfica de Azure donde se desplegarán los recursos."
      }
    },
    "dbAdminLogin": {
      "type": "string",
      "defaultValue": "adminjuridico",
      "metadata": {
        "description": "Nombre de usuario administrador para la base de datos PostgreSQL Flexible Server."
      }
    },
    "dbAdminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Contraseña maestra para PostgreSQL (mínimo 8 caracteres, al menos 1 mayúscula, 1 minúscula y 1 número)."
      }
    },
    "appApiKey": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "API Key maestra opcional para control de acceso (X-API-KEY). Si se deja vacía, se generará un valor seguro aleatorio."
      }
    },
    "initialAdminEmail": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Correo de la cuenta designada como administradora inicial de la plataforma."
      }
    },
    "githubRepoUrl": {
      "type": "string",
      "defaultValue": "https://github.com/KarlaAlexaBaltazarCorona-bit/G19X-ITSA-KABC-977-ACADEMIC.git",
      "metadata": {
        "description": "URL del repositorio Git que contiene el código fuente para despliegue automatizado continuo."
      }
    },
    "githubBranch": {
      "type": "string",
      "defaultValue": "main",
      "metadata": {
        "description": "Rama Git a desplegar en el App Service."
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[uniqueString(resourceGroup().id)]",
    "isEnterprise": "[equals(parameters('environmentType'), 'Enterprise_HA')]",
    "storageAccountName": "[take(concat('st', replace(parameters('appNamePrefix'), '-', ''), variables('uniqueSuffix')), 24)]",
    "pgServerName": "[concat('pg-', parameters('appNamePrefix'), '-', variables('uniqueSuffix'))]",
    "openaiName": "[concat('oai-', parameters('appNamePrefix'), '-', variables('uniqueSuffix'))]",
    "docIntelName": "[concat('di-', parameters('appNamePrefix'), '-', variables('uniqueSuffix'))]",
    "searchServiceName": "[concat('srch-', parameters('appNamePrefix'), '-', variables('uniqueSuffix'))]",
    "appServicePlanName": "[concat('asp-', parameters('appNamePrefix'), '-', variables('uniqueSuffix'))]",
    "appServiceName": "[concat('app-', parameters('appNamePrefix'), '-', variables('uniqueSuffix'))]",
    "storageSku": "[if(variables('isEnterprise'), 'Standard_ZRS', 'Standard_LRS')]",
    "pgSkuName": "[if(variables('isEnterprise'), 'Standard_D2ds_v5', 'Standard_B1ms')]",
    "pgTier": "[if(variables('isEnterprise'), 'GeneralPurpose', 'Burstable')]",
    "pgHaMode": "[if(variables('isEnterprise'), 'ZoneRedundant', 'Disabled')]",
    "appServiceSku": "[if(variables('isEnterprise'), 'P1v3', 'B1')]",
    "openAiCapacity": "[if(variables('isEnterprise'), 100, 50)]",
    "resolvedApiKey": "[if(empty(parameters('appApiKey')), concat('lt_', uniqueString(resourceGroup().id, deployment().name, 'apikey')), parameters('appApiKey'))]",
    "resolvedEncryptionKey": "[base64(concat(uniqueString(resourceGroup().id, 'k1'), uniqueString(resourceGroup().id, 'k2'), '123456'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[variables('storageSku')]"
      },
      "kind": "StorageV2",
      "properties": {
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false
      },
      "resources": [
        {
          "type": "blobServices/containers",
          "apiVersion": "2023-01-01",
          "name": "default/documentos",
          "dependsOn": [
            "[variables('storageAccountName')]"
          ],
          "properties": {
            "publicAccess": "None"
          }
        }
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2023-03-01-preview",
      "name": "[variables('pgServerName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[variables('pgSkuName')]",
        "tier": "[variables('pgTier')]"
      },
      "properties": {
        "administratorLogin": "[parameters('dbAdminLogin')]",
        "administratorLoginPassword": "[parameters('dbAdminPassword')]",
        "version": "16",
        "storage": {
          "storageSizeGB": 32,
          "autoGrow": "Enabled"
        },
        "highAvailability": {
          "mode": "[variables('pgHaMode')]"
        }
      },
      "resources": [
        {
          "type": "databases",
          "apiVersion": "2023-03-01-preview",
          "name": "legaltech_db",
          "dependsOn": [
            "[variables('pgServerName')]"
          ],
          "properties": {
            "charset": "UTF8",
            "collation": "en_US.utf8"
          }
        },
        {
          "type": "firewallRules",
          "apiVersion": "2023-03-01-preview",
          "name": "AllowAllWindowsAzureIps",
          "dependsOn": [
            "[variables('pgServerName')]"
          ],
          "properties": {
            "startIpAddress": "0.0.0.0",
            "endIpAddress": "0.0.0.0"
          }
        }
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('openaiName')]",
      "location": "[parameters('location')]",
      "kind": "OpenAI",
      "sku": {
        "name": "S0"
      },
      "properties": {
        "customSubDomainName": "[variables('openaiName')]",
        "publicNetworkAccess": "Enabled"
      },
      "resources": [
        {
          "type": "deployments",
          "apiVersion": "2023-05-01",
          "name": "gpt-5-mini",
          "dependsOn": [
            "[variables('openaiName')]"
          ],
          "sku": {
            "name": "GlobalStandard",
            "capacity": "[variables('openAiCapacity')]"
          },
          "properties": {
            "model": {
              "format": "OpenAI",
              "name": "gpt-5-mini",
              "version": "2025-08-07"
            },
            "versionUpgradeOption": "OnceNewDefaultVersionAvailable"
          }
        },
        {
          "type": "deployments",
          "apiVersion": "2023-05-01",
          "name": "text-embedding-3-small",
          "dependsOn": [
            "[variables('openaiName')]",
            "gpt-5-mini"
          ],
          "sku": {
            "name": "GlobalStandard",
            "capacity": 1
          },
          "properties": {
            "model": {
              "format": "OpenAI",
              "name": "text-embedding-3-small",
              "version": "1"
            },
            "versionUpgradeOption": "OnceNewDefaultVersionAvailable"
          }
        }
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('docIntelName')]",
      "location": "[parameters('location')]",
      "kind": "FormRecognizer",
      "sku": {
        "name": "S0"
      },
      "properties": {
        "customSubDomainName": "[variables('docIntelName')]",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Search/searchServices",
      "apiVersion": "2023-11-01",
      "name": "[variables('searchServiceName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "basic"
      },
      "properties": {
        "replicaCount": 1,
        "partitionCount": 1
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-01-01",
      "name": "[variables('appServicePlanName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "properties": {
        "reserved": true
      },
      "sku": {
        "name": "[variables('appServiceSku')]"
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "name": "[variables('appServiceName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[variables('appServicePlanName')]",
        "[variables('storageAccountName')]",
        "[variables('pgServerName')]",
        "[variables('openaiName')]",
        "[variables('docIntelName')]",
        "[variables('searchServiceName')]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "PYTHON|3.11",
          "alwaysOn": true,
          "appCommandLine": "gunicorn --bind 0.0.0.0:8000 -k uvicorn.workers.UvicornWorker main:app",
          "appSettings": [
            {
              "name": "WEBSITES_PORT",
              "value": "8000"
            },
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "true"
            },
            {
              "name": "POSTGRES_URL",
              "value": "[concat('postgresql+psycopg2://', parameters('dbAdminLogin'), ':', parameters('dbAdminPassword'), '@', reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('pgServerName'))).fullyQualifiedDomainName, ':5432/legaltech_db?sslmode=require')]"
            },
            {
              "name": "AZURE_OPENAI_ENDPOINT",
              "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('openaiName'))).endpoint]"
            },
            {
              "name": "AZURE_OPENAI_API_KEY",
              "value": "[listKeys(resourceId('Microsoft.CognitiveServices/accounts', variables('openaiName')), '2023-05-01').key1]"
            },
            {
              "name": "AZURE_OPENAI_DEPLOYMENT_NAME",
              "value": "gpt-5-mini"
            },
            {
              "name": "AZURE_OPENAI_API_VERSION",
              "value": "2024-08-01-preview"
            },
            {
              "name": "AZURE_OPENAI_MAX_TOKENS",
              "value": "1000"
            },
            {
              "name": "AZURE_OPENAI_REASONING_EFFORT",
              "value": "low"
            },
            {
              "name": "AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT",
              "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('docIntelName'))).endpoint]"
            },
            {
              "name": "AZURE_DOCUMENT_INTELLIGENCE_KEY",
              "value": "[listKeys(resourceId('Microsoft.CognitiveServices/accounts', variables('docIntelName')), '2023-05-01').key1]"
            },
            {
              "name": "AZURE_STORAGE_ACCOUNT_NAME",
              "value": "[variables('storageAccountName')]"
            },
            {
              "name": "AZURE_STORAGE_CONTAINER_NAME",
              "value": "documentos"
            },
            {
              "name": "AZURE_STORAGE_CONNECTION_STRING",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('storageAccountName'), ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-01-01').keys[0].value, ';EndpointSuffix=core.windows.net')]"
            },
            {
              "name": "AZURE_SEARCH_ENDPOINT",
              "value": "[concat('https://', variables('searchServiceName'), '.search.windows.net')]"
            },
            {
              "name": "AZURE_SEARCH_KEY",
              "value": "[listAdminKeys(resourceId('Microsoft.Search/searchServices', variables('searchServiceName')), '2023-11-01').primaryKey]"
            },
            {
              "name": "APP_API_KEY",
              "value": "[variables('resolvedApiKey')]"
            },
            {
              "name": "APP_ENCRYPTION_KEY",
              "value": "[variables('resolvedEncryptionKey')]"
            },
            {
              "name": "RATE_LIMIT_ENABLED",
              "value": "true"
            },
            {
              "name": "RATE_LIMIT_PER_MINUTE",
              "value": "2400"
            },
            {
              "name": "MAX_REQUEST_BODY_BYTES",
              "value": "10485760"
            },
            {
              "name": "INITIAL_ADMIN_EMAIL",
              "value": "[parameters('initialAdminEmail')]"
            },
            {
              "name": "ENABLE_DOCS",
              "value": "false"
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "appServiceUrl": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', variables('appServiceName'))).defaultHostName)]"
    },
    "appApiKey": {
      "type": "string",
      "value": "[variables('resolvedApiKey')]"
    },
    "postgresServer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('pgServerName'))).fullyQualifiedDomainName]"
    },
    "openAiEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('openaiName'))).endpoint]"
    },
    "docIntelEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('docIntelName'))).endpoint]"
    }
  }
}
