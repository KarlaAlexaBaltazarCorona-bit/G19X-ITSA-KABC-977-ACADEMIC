# ═══════════════════════════════════════════════════════════════════════════
# PlastiOne LegalTech — Variables de Entorno del Backend
# ═══════════════════════════════════════════════════════════════════════════
#
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena los valores marcados con TODO
#   3. NUNCA subas el archivo .env a Git (ya está en .gitignore)
#
# DÓNDE VAN LOS TOKENS / KEYS DE MICROSOFT ENTRA ID:
#   ──────────────────────────────────────────────────────
#   ENTRA_CLIENT_ID  → Application (client) ID del App Registration en Azure
#   ENTRA_TENANT_ID  → 'organizations' (Multi-Tenant Corporativo recomendado)
#                      o el Directory (tenant) ID si deseas restringir a tu único tenant.
#   ENTRA_ALLOWED_TENANTS → (Opcional) IDs de inquilinos autorizados separados por coma.
#
#   Cómo configurarlo para que funcione en TU tenant y en OTROS tenants corporativos:
#     1. Portal Azure → Microsoft Entra ID → App registrations → Nuevo registro
#     2. Nombre: "LegalTech PluriOne" (o el nombre de tu plataforma)
#     3. Tipos de cuenta admitidos (Supported account types):
#        Selecciona: "Cuentas en cualquier directorio organizativo (cualquier inquilino de Microsoft Entra ID - Multi-inquilino)"
#        (En inglés: "Accounts in any organizational directory - Multitenant")
#     4. En "Authentication" → "Platform configurations" → Agregar "Single-page application (SPA)"
#        Redirect URIs:
#        - http://localhost:8000/login  (desarrollo local)
#        - https://tu-dominio.azurewebsites.net/login  (producción)
#     5. En "App roles" → crea los 4 roles con estos valores EXACTOS (Value):
#        - REVISOR_JURIDICO
#        - APROBADOR_JURIDICO
#        - ADMINISTRADOR_PLATAFORMA
#        - AUDITOR
#     6. En "Enterprise applications" → asigna usuarios/grupos a los roles.
#        (En otros tenants corporativos, los administradores consienten la app y asignan roles).
# ═══════════════════════════════════════════════════════════════════════════

# ── BASE DE DATOS ──────────────────────────────────────────────────────────
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_base_de_datos
# Para desarrollo local con Docker: usa el valor de abajo sin cambios
# Para producción en Azure: usa la cadena de conexión de Azure Database for PostgreSQL
POSTGRES_URL=postgresql+psycopg2://legaltech:legaltech_dev@localhost:5432/legaltech_db

# ── MICROSOFT ENTRA ID (SSO Corporativo Multi-Tenant) ─────────────────────
# ENTRA_CLIENT_ID: Application (client) ID del App Registration en Azure
ENTRA_CLIENT_ID=

# ENTRA_TENANT_ID:
#   - 'organizations' (RECOMENDADO): Multi-tenant corporativo. Permite iniciar sesión
#     con cuentas de TU propio tenant y de CUALQUIER otro tenant corporativo de Entra ID,
#     rechazando cuentas personales no corporativas (@hotmail/@outlook).
#   - '<tu-tenant-id>': Si deseas restringir exclusivamente a tu propia empresa.
#   - 'common': Permite tenants corporativos + cuentas personales Microsoft.
ENTRA_TENANT_ID=organizations

# ENTRA_ALLOWED_TENANTS: (Opcional) Lista blanca de tenant IDs separados por coma.
# Déjalo vacío para permitir cualquier tenant corporativo.
ENTRA_ALLOWED_TENANTS=

# ── AZURE OPENAI (Análisis jurídico con IA) ────────────────────────────────
# TODO: Obtener desde Portal Azure → Azure OpenAI → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://your-openai-service.openai.azure.com/
AZURE_OPENAI_API_KEY=      # ← Pegar aquí la Key 1 o Key 2 del servicio
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── AZURE AI SEARCH (Búsqueda semántica de documentos) ────────────────────
# TODO: Obtener desde Portal Azure → AI Search → Keys
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=          # ← Pegar aquí la Admin Key

# ── AZURE DOCUMENT INTELLIGENCE (OCR + Detección de firmas) ───────────────
# TODO: Obtener desde Portal Azure → Document Intelligence → Keys and Endpoint
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-docintel.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=      # ← Pegar aquí Key 1

# ── AZURE BLOB STORAGE (Almacenamiento de documentos PDF) ─────────────────
# TODO: Obtener desde Portal Azure → Storage Account → Access keys
AZURE_STORAGE_ACCOUNT_NAME=almacenlegalprojectia
AZURE_STORAGE_CONTAINER_NAME=documentos
AZURE_STORAGE_CONNECTION_STRING=      # ← Pegar aquí la Connection string completa

# ── SEGURIDAD DEL BACKEND ──────────────────────────────────────────────────
# APP_API_KEY: Clave que el frontend incluye en el header X-API-KEY.
# Cambia el valor por defecto en producción. Genera uno con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=your_secure_api_key_here_minimum_32_chars

# APP_ENCRYPTION_KEY: Clave AES-256 para cifrar datos sensibles en BD.
# Genera una con: python3 -c "from app.core.security import generate_new_master_key; print(generate_new_master_key())"
APP_ENCRYPTION_KEY=        # ← Generar y pegar aquí

# ── CONFIGURACIÓN GENERAL ──────────────────────────────────────────────────
# Límite de peticiones por minuto por IP (protección DoS)
RATE_LIMIT_PER_MINUTE=600

# Tamaño máximo de archivos subidos en bytes (2MB = 2097152, 10MB = 10485760)
MAX_REQUEST_BODY_BYTES=10485760

# Mostrar documentación Swagger en /docs (solo en desarrollo)
# En producción dejar en "false"
ENABLE_DOCS=true
